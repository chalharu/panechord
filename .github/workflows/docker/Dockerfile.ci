# Prebuilt Linux CI image for panechord: system dependencies are baked in so
# jobs never run `apt-get update` at runtime (removes the Ubuntu-repository
# flakiness and the per-run build cost). Content-hash tagged from CI; local
# development keeps using scripts/Dockerfile.linux directly.
# Tools are prebuilt upstream: download the pinned release binaries
# instead of compiling them (faster image builds, no extra rustc needed).
# Versions follow the 3-day minimum-age rule; keep in sync with
# .github/workflows/coverage.yml.
FROM rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37 AS builder
# Prebuilt tool versions (single source; renovate tracks the annotated ARGs).
# New releases apply only after the 3-day minimum release age.
ARG NEXTEST_VERSION=0.9.150 # renovate: datasource=crate depName=cargo-nextest
ARG LLVM_COV_VERSION=0.9.1 # renovate: datasource=crate depName=cargo-llvm-cov
# hadolint ignore=DL3008
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tools \
    && curl --proto '=https' -fsSL -o /tmp/nextest.tar.gz "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${NEXTEST_VERSION}/cargo-nextest-${NEXTEST_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    && curl --proto '=https' -fsSL -o /tmp/llvm-cov.tar.gz "https://github.com/taiki-e/cargo-llvm-cov/releases/download/v${LLVM_COV_VERSION}/cargo-llvm-cov-x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/nextest.tar.gz -C /tools \
    && tar -xzf /tmp/llvm-cov.tar.gz -C /tools \
    && /tools/cargo-nextest --version \
    && /tools/cargo-llvm-cov llvm-cov --version \
    && rm /tmp/nextest.tar.gz /tmp/llvm-cov.tar.gz

FROM rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37

# hadolint ignore=DL3002
USER 0

# One-shot builder: no daemon healthcheck by design.
HEALTHCHECK NONE

# Union of scripts/Dockerfile.linux (GTK3/4, Tao, X11/Xvfb) and the
# link toolchain the coverage legs need (clang, mold). One layer, then the
# apt lists are deleted inside the same layer.
# hadolint ignore=DL3008
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates \
    clang \
    cmake \
    dbus-x11 \
    fonts-dejavu-core \
    fonts-noto-cjk \
    gdb \
    imagemagick \
    libasound2-dev \
    libgl1-mesa-dri \
    libgtk-3-dev \
    libgtk-4-dev \
    libudev-dev \
    libx11-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libxdo-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libxtst-dev \
    make \
    mold \
    pkg-config \
    python3 \
    python3-yaml \
    tesseract-ocr \
    xauth \
    xdotool \
    xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy llvm-tools-preview \
    && rm -rf /usr/local/cargo/registry/cache/* \
    && rm -rf /usr/local/cargo/registry/index/*

COPY --from=builder /tools/cargo-llvm-cov /usr/local/cargo/bin/cargo-llvm-cov
COPY --from=builder /tools/cargo-nextest /usr/local/cargo/bin/cargo-nextest

ENV CARGO_BUILD_JOBS=1 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
WORKDIR /workspace
