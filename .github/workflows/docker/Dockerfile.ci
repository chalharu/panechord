# Prebuilt Linux CI image for panechord: system dependencies are baked in so
# jobs never run `apt-get update` at runtime (removes the Ubuntu-repository
# flakiness and the per-run build cost). Content-hash tagged from CI; local
# development keeps using scripts/Dockerfile.linux directly.
FROM rust:1.99.1-slim@sha256:7eab7ce19273ce785e0ca7578bdf7bc1fcbae621775a8197379a04c9f6e03cd5 AS builder
RUN cargo install cargo-llvm-cov --locked --version=0.9.1 \
    && cargo install cargo-nextest --locked --version=0.9.150 \
    --no-default-features --features=default-no-update

FROM rust:1.99.1-slim@sha256:7eab7ce19273ce785e0ca7578bdf7bc1fcbae621775a8197379a04c9f6e03cd5

# hadolint ignore=DL3002
USER 0

# Union of scripts/Dockerfile.linux (GTK3/4, Tao, X11/Xvfb) and the
# link toolchain the coverage legs need (clang, mold). One layer, then the
# apt lists are deleted inside the same layer.
# hadolint ignore=DL3008
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates \
    clang \
    cmake \
    dbus-x11 \
    fonts-dejavu-core \
    fonts-noto-cjk \
    gdb \
    imagemagick \
    libasound2-dev \
    libgl1-mesa-dri \
    libgtk-3-dev \
    libgtk-4-dev \
    libudev-dev \
    libx11-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libxdo-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libxtst-dev \
    make \
    mold \
    pkg-config \
    python3 \
    python3-yaml \
    tesseract-ocr \
    xauth \
    xdotool \
    xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy llvm-tools-preview \
    && rm -rf /usr/local/cargo/registry/cache/* \
    && rm -rf /usr/local/cargo/registry/index/*

COPY --from=builder /usr/local/cargo/bin/cargo-llvm-cov /usr/local/cargo/bin/cargo-llvm-cov
COPY --from=builder /usr/local/cargo/bin/cargo-nextest /usr/local/cargo/bin/cargo-nextest

ENV CARGO_BUILD_JOBS=1 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
WORKDIR /workspace
