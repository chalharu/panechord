{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":disableRateLimiting",
        ":dependencyDashboard",
        "helpers:pinGitHubActionDigests"
    ],
    "timezone": "Asia/Tokyo",
    "configMigration": true,
    "configWarningReuseIssue": false,
    "labels": ["renovate"],
    "rebaseWhen": "behind-base-branch",
    "pruneStaleBranches": true,
    "separateMajorMinor": true,
    "separateMinorPatch": true,
    "separateMultipleMajor": true,
    "separateMultipleMinor": true,
    "automerge": true,
    "automergeStrategy": "auto",
    "platformAutomerge": false,
    "pinDigests": true,
    "internalChecksFilter": "none",
    "prCreation": "immediate",
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["renovate", "security"],
        "minimumReleaseAge": null
    },
    "lockFileMaintenance": {
        "enabled": true
    },
    "rangeStrategy": "pin",
    "minimumReleaseAge": "3 days",
    "minimumReleaseAgeBehaviour": "timestamp-required",
    "packageRules": [
        {
            "description": "Disable release-age checks for update types without upstream release timestamps.",
            "matchUpdateTypes": [
                "digest",
                "pin",
                "pinDigest",
                "lockFileMaintenance",
                "lockFileUpdate",
                "rollback",
                "bump",
                "replacement"
            ],
            "minimumReleaseAge": null
        },
        {
            "description": "Use the custom stability-days check for non-Docker Hub Docker registries without release timestamps.",
            "matchDatasources": ["docker"],
            "matchPackageNames": [
                "/^[^\\/]+[.:][^\\/]+\\//",
                "!/^index\\.docker\\.io\\//",
                "!/^docker\\.io\\//",
                "!/^registry-1\\.docker\\.io\\//"
            ],
            "minimumReleaseAge": null,
            "addLabels": ["renovate-wait-3d"]
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update renovate-version in the Renovate workflow",
            "managerFilePatterns": ["/(^|/)\\.github/workflows/renovate\\.ya?ml$/"],
            "matchStrings": [
                "(?:^|\\n)\\s+renovate-version:\\s*['\"]?(?<currentValue>[^\\s'\"]+)['\"]?\\s*(?:\\n|$)"
            ],
            "datasourceTemplate": "docker",
            "depNameTemplate": "ghcr.io/renovatebot/renovate",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update cargo-ndk version in the Android install helper",
            "managerFilePatterns": [
                "/(^|/)packaging/android/install-cargo-ndk\\.sh$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+readonly DEFAULT_CARGO_NDK_VERSION=\"(?<currentValue>[^\"]+)\""
            ],
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Track prebuilt nextest version in CI tooling",
            "managerFilePatterns": [
                "/(^|/)\\.github/workflows/coverage\\.ya?ml$/",
                "/(^|/)Dockerfile\\.ci$/"
            ],
            "matchStrings": [
                "NEXTEST_VERSION[=:]\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "nextest-rs/nextest",
            "extractVersionTemplate": "^cargo-nextest-(?<version>.+)$"
        },
        {
            "customType": "regex",
            "description": "Track prebuilt cargo-llvm-cov version in CI tooling",
            "managerFilePatterns": [
                "/(^|/)\\.github/workflows/coverage\\.ya?ml$/",
                "/(^|/)Dockerfile\\.ci$/"
            ],
            "matchStrings": [
                "LLVM_COV_VERSION[=:]\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "taiki-e/cargo-llvm-cov",
            "extractVersionTemplate": "^v(?<version>.+)$"
        },
        {
            "customType": "regex",
            "description": "Track Rust toolchain version in CI workflows",
            "managerFilePatterns": [
                "/(^|/)\\.github/workflows/(coverage|panechord)\\.ya?ml$/"
            ],
            "matchStrings": [
                "RUST_TOOLCHAIN:\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "rust-lang/rust"
        }
    ]
}
