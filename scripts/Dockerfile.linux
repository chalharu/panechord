ARG RUST_VERSION=1.99.1
FROM rust:${RUST_VERSION}-slim-bookworm
# One-shot builder: no daemon healthcheck by design.
HEALTHCHECK NONE
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cmake dbus-x11 fonts-dejavu-core fonts-noto-cjk gdb \
    imagemagick libasound2-dev libgl1-mesa-dri libgtk-3-dev libgtk-4-dev \
    libudev-dev libx11-dev libxcb-shape0-dev libxcb-xfixes0-dev libxdo-dev \
    libxkbcommon-dev libxkbcommon-x11-dev libxtst-dev pkg-config python3 \
    python3-yaml tesseract-ocr xauth xdotool xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy
ENV CARGO_BUILD_JOBS=1 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
WORKDIR /workspace
COPY . .
RUN cargo fetch --locked
CMD ["sh", "scripts/verify.sh"]